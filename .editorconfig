root = true

# Rules shared by all text files
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Preserve the encoding chosen by EF for generated migrations
[Migrations/*.cs]
charset = unset

# C# and Razor
[*.{cs,cshtml}]
indent_size = 4

# Always use braces around control-flow bodies
csharp_prefer_braces = true:suggestion

# Put opening braces on a new line
csharp_new_line_before_open_brace = all

# Prefer normal block-scoped methods over expression bodies
csharp_style_expression_bodied_methods = false:suggestion

# Prefer language keywords such as string and int
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Interfaces should begin with I
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = begins_with_i
dotnet_naming_rule.interfaces_begin_with_i.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# JavaScript, JSON, CSS and HTML
[*.{js,jsx,json,css,html}]
indent_size = 2

# Markdown intentionally uses trailing spaces for hard line breaks
[*.md]
trim_trailing_whitespace = false
