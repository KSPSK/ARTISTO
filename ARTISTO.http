@HostAddress = https://localhost:7143

### Get all artwork listings

GET {{HostAddress}}/api/artworklistings
Accept: application/json

### Get a single artwork listing by id

GET {{HostAddress}}/api/artworklistings/1
Accept: application/json

### Get an artwork listing that does not exist (expect 404 Not Found)

GET {{HostAddress}}/api/artworklistings/999
Accept: application/json

### Create a new artwork listing
# Requires a successful registration or login request first.

POST {{HostAddress}}/api/artworklistings
Content-Type: application/json

{
  "title": "Blue Horizon",
  "description": "A small original seascape painting.",
  "price": 150.00,
  "creatorName": "Geronimo",
  "category": "Painting",
  "localPickupAvailable": true
}

### Update an artwork listing

PUT {{HostAddress}}/api/artworklistings/1
Content-Type: application/json

{
  "title": "Evening in Vilnius",
  "description": "An updated original cityscape painting.",
  "price": 140.00,
  "creatorName": "Geronimo",
  "category": "Painting",
  "localPickupAvailable": true
}

### Delete an artwork listing

DELETE {{HostAddress}}/api/artworklistings/2

### Create a listing with invalid data (expect 400 Bad Request)

POST {{HostAddress}}/api/artworklistings
Content-Type: application/json

{
  "title": "",
  "description": "Missing a title, creator name, and a valid price.",
  "price": 0,
  "creatorName": "",
  "category": "Painting",
  "localPickupAvailable": false
}

### Register a new user
POST {{HostAddress}}/api/users/register
Content-Type: application/json

{
  "username": "geronimo",
  "password": "Password123!",
  "displayName": "Geronimo",
  "description": "Oil painter from Vilnius.",
  "city": "Vilnius"
}

### Login as user
POST {{HostAddress}}/api/users/login
Content-Type: application/json

{
  "username": "geronimo",
  "password": "Password123!"
}

### Get the currently authenticated user
GET {{HostAddress}}/api/users/me
Accept: application/json

### Log out
POST {{HostAddress}}/api/users/logout

### Get all users
GET {{HostAddress}}/api/users
Accept: application/json

### Get a user by ID
GET {{HostAddress}}/api/users/1
Accept: application/json

### Update a user profile
PUT {{HostAddress}}/api/users/1
Content-Type: application/json

{
  "displayName": "Geronimo Art",
  "description": "Oil painter and sketch artist.",
  "city": "Kaunas"
}

### Link a listing to a user
PUT {{HostAddress}}/api/artworklistings/1
Content-Type: application/json

{
  "title": "Blue Horizon",
  "description": "A small original seascape painting.",
  "price": 150.00,
  "creatorName": "Geronimo",
  "category": "Painting",
  "localPickupAvailable": true,
  "userId": 1
}

### Get artwork listings of a user
GET {{HostAddress}}/api/users/1/artworklistings
Accept: application/json

### Get a user that does not exist (expect 404)
GET {{HostAddress}}/api/users/999
Accept: application/json

### Link a listing to a user that does not exist (expect 400)
PUT {{HostAddress}}/api/artworklistings/1
Content-Type: application/json

{
  "title": "Blue Horizon",
  "description": "A small original seascape painting.",
  "price": 150.00,
  "creatorName": "Geronimo",
  "category": "Painting",
  "localPickupAvailable": true,
  "userId": 999
}

### Register with invalid data (expect 400)
POST {{HostAddress}}/api/users/register
Content-Type: application/json

{
  "username": "",
  "password": "12",
  "displayName": "",
  "city": ""
}
